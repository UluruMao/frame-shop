# Aliyun 短信认证服务 (dypnsapi) 凭据模板.
# 复制本文件为 .env (会被 gitignore，不进 git), 填入真实值, 然后用:
#   set -a; source .env; set +a; cd frame-backend && java -jar target/frame-backend-0.0.1-SNAPSHOT.jar
#
# 4 个必填值从阿里云"号码认证服务"控制台 + RAM 控制台获取:
FRAME_SMS_PROVIDER=aliyun
FRAME_SMS_AK_ID=你的RAM_AccessKeyId
FRAME_SMS_AK_SECRET=你的RAM_AccessKeySecret
FRAME_SMS_SIGN_NAME=恒创联众
FRAME_SMS_TEMPLATE_CODE=100001
FRAME_SMS_REGION=cn-hangzhou
